name: Auto-Approve Alert Requests

# Runs on GitHub's own servers, independent of whether anyone's
# computer has the admin panel open — this is what lets a device
# flagged for auto-approve actually behave that way, with no app
# needing to be running anywhere for a request to go live.
#
# GitHub's shortest supported schedule interval is every 5 minutes,
# and actual runs can lag a few minutes behind that during busy
# periods — this is not an instant, real-time path. If the admin
# panel is open somewhere, its own background check is faster; this
# workflow exists specifically to cover the hours nobody has it open.
on:
  schedule:
    - cron: "*/5 * * * *"
  workflow_dispatch: {}  # lets this be triggered manually too, e.g. to test

jobs:
  auto-approve:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      # No third-party dependencies at all — the script only uses
      # Python's own standard library, so no install step is needed
      # here beyond setting up Python itself.
      - name: Run auto-approve worker
        env:
          # This repo's own secret, NOT a hardcoded value anywhere in
          # this file or the script — set it under this repo's Settings
          # -> Secrets and variables -> Actions -> "New repository
          # secret", named exactly CASTBOARD_GITHUB_TOKEN. Deliberately
          # NOT named GITHUB_TOKEN as the env var here even though the
          # secret's own name contains it — GITHUB_TOKEN is a reserved
          # name GitHub Actions auto-provides on every run for its own
          # limited-scope bot access to this repo, and reusing that
          # exact name for a different, personal-access-token secret
          # risks real confusion later (e.g. a future step that expects
          # the real automatic one). CASTBOARD_TOKEN avoids that
          # collision entirely while still being the same underlying
          # secret value.
          #
          # This is a genuine GitHub personal access token with write
          # access to castboard-data, encrypted at rest, never shown in
          # any log, and usable only by workflows in this repo — a
          # materially safer place for it than baking it into a
          # distributed .exe or .py file, which is the whole reason it
          # lives here instead of directly in auto_approve_alerts.py.
          CASTBOARD_TOKEN: ${{ secrets.CASTBOARD_GITHUB_TOKEN }}
        run: |
          echo "## Auto-Approve Worker Output" >> "$GITHUB_STEP_SUMMARY"
          echo '```' >> "$GITHUB_STEP_SUMMARY"
          python auto_approve_alerts.py 2>&1 | tee -a "$GITHUB_STEP_SUMMARY"
          echo '```' >> "$GITHUB_STEP_SUMMARY"
